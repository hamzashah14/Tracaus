{
  "openapi": "3.0.0",
  "info": {
    "title": "CloudWatch Logs Fetcher",
    "version": "3.0.0",
    "description": "Lists an EC2 instance's or ECS service's log groups, or searches one around an incident time"
  },
  "paths": {
    "/fetch_cloudwatch_logs": {
      "get": {
        "summary": "Discover an instance's log groups, or search one for log lines and activity gaps",
        "description": "Discover log groups using instance_id. Results are paginated: continue with next_token until complete=true, keeping the same instance. Never guess group names. Search a discovered log_group_name around time_string for logs and activity. Partial results explicitly state complete=false. A silent gap alone does not establish a cause; check traffic and telemetry freshness. Discovery includes scoped metric_catalog hints (metric_id/name). Use these IDs for exact configured Health metrics. If metric_catalog_complete=false, descriptor hints were omitted to fit the transport budget; declare incomplete coverage.",
        "operationId": "fetch_cloudwatch_logs",
        "parameters": [
          {
            "name": "instance_id",
            "in": "query",
            "required": false,
            "description": "Target ID: an EC2 instance ID such as i-0123456789abcdef0, or an ECS service ID such as ecs-orders. Alone, it lists that target's log groups.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "log_group_name",
            "in": "query",
            "required": false,
            "description": "Exact log group name returned by discovery. Omit it to run discovery instead.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter_text",
            "in": "query",
            "required": false,
            "description": "Case-insensitive text the returned lines must contain. Separate alternatives with |, e.g. error|timeout|exception. Leave empty to see every line \u2014 do that when investigating a hang, since a frozen process often logs no error at all.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "time_string",
            "in": "query",
            "required": false,
            "description": "Incident timestamp: ISO-8601 with UTC/offset, or YYYY-MM-DD HH:MM:SS interpreted as UTC. Offsets normalize to UTC.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "window_minutes",
            "in": "query",
            "required": false,
            "description": "With time_string: minutes before and after the incident to cover (1-180).",
            "schema": {
              "type": "string",
              "default": "30"
            }
          },
          {
            "name": "hours_back",
            "in": "query",
            "required": false,
            "description": "Without time_string: hours back from now to search (1-24).",
            "schema": {
              "type": "string",
              "default": "1"
            }
          },
          {
            "name": "lines",
            "in": "query",
            "required": false,
            "description": "Maximum lines to return on each side of the incident (1-50).",
            "schema": {
              "type": "string",
              "default": "20"
            }
          },
          {
            "name": "next_token",
            "in": "query",
            "required": false,
            "description": "Opaque continuation from discovery; valid for the same instance/environment for one hour. Omit for search.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful, empty or explicitly partial evidence",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok",
                        "partial",
                        "log_groups_found",
                        "no_log_groups_found",
                        "no_matching_lines"
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "complete": {
                      "type": "boolean"
                    },
                    "truncated": {
                      "type": "boolean"
                    },
                    "instance_id": {
                      "type": "string",
                      "nullable": true
                    },
                    "log_groups": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "next_token": {
                      "type": "string"
                    },
                    "log_group": {
                      "type": "string"
                    },
                    "filter_text": {
                      "type": "string",
                      "nullable": true
                    },
                    "window_start": {
                      "type": "string"
                    },
                    "window_end": {
                      "type": "string"
                    },
                    "incident_time": {
                      "type": "string"
                    },
                    "activity_all_lines": {
                      "type": "object",
                      "properties": {
                        "bin_minutes": {
                          "type": "integer"
                        },
                        "total_lines": {
                          "type": "integer"
                        },
                        "silent_gaps": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "from": {
                                "type": "string"
                              },
                              "to": {
                                "type": "string"
                              },
                              "minutes": {
                                "type": "integer"
                              },
                              "note": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "from",
                              "to",
                              "minutes"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "lines_per_bin": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "bin_minutes",
                        "total_lines",
                        "silent_gaps",
                        "lines_per_bin"
                      ],
                      "additionalProperties": false
                    },
                    "lines_before": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "timestamp": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "timestamp",
                          "message"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "lines_after": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "timestamp": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "timestamp",
                          "message"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "timestamp": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "timestamp",
                          "message"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "metric_catalog_complete": {
                      "type": "boolean"
                    },
                    "metric_catalog": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "metric_id": {
                            "type": "string"
                          },
                          "metric_name": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "metric_id",
                          "metric_name"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "status",
                    "complete",
                    "truncated"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid or unauthorized input",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "error"
                      ]
                    },
                    "error_code": {
                      "type": "string"
                    },
                    "request_id": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "error_code",
                    "request_id",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "502": {
            "description": "Upstream access, query or response-budget failure",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "error"
                      ]
                    },
                    "error_code": {
                      "type": "string"
                    },
                    "request_id": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "error_code",
                    "request_id",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
