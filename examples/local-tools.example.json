{
  "version": 1,
  "monitor_region": "eu-central-1",
  "log_prefix": "/tracaus/staging",
  "instances": [
    "i-0123456789abcdef0"
  ],
  "log_groups": [
    "/tracaus/staging/i-0123456789abcdef0/app",
    "/tracaus/staging/i-0123456789abcdef0/error"
  ],
  "metric_catalog": [
    {
