      "dimensions": {
        "InstanceId": "i-0123456789abcdef0"
      }
    },
    {
      "id": "web-disk",
      "instance_id": "i-0123456789abcdef0",
      "namespace": "CWAgent",
      "metric_name": "disk_used_percent",
      "statistic": "Average",
      "dimensions": {
        "InstanceId": "i-0123456789abcdef0",
        "path": "/"
      }
    }
  ]
