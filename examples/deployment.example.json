{
  "project": "tracaus",
  "environment": "staging",
  "account_id": "123456789012",
  "monitor_region": "eu-central-1",
  "bedrock_region": "eu-central-1",
  "release_id": "example001",
  "model_id": "example.model-v1",
  "model_arns": [
    "arn:aws:bedrock:eu-central-1::foundation-model/example.model-v1"
  ],
  "executor_mode": "qualified",
  "notification_email": "operator@example.invalid",
  "reserved_concurrency": null,
  "maintenance_mode": false,
  "log_retention_days": 30,
  "ui_principal_arn": "arn:aws:iam::123456789012:role/customer-ui",
  "ci_principal_arn": "arn:aws:iam::123456789012:role/customer-ci",
  "deployment_role_arn": "arn:aws:iam::123456789012:role/customer-cfn-deployment",
  "instances": [
    {
      "id": "i-0123456789abcdef0",
      "log_groups": [
        "application"
      ],
      "disk_path": "/",
      "resource_alarms": true,
      "nginx_alarm": true,
      "process_exe": "nginx"
    }
  ],
  "nginx_filters": {
    "access": {
      "pattern": "[ip, ident, user, timestamp, request, status_code = 502 || status_code = 504, bytes, referer, agent]",
      "match": "203.0.113.7 - - [24/Sep/2026:10:15:32 +0000] \"GET / HTTP/1.1\" 504 167 \"-\" \"test\"",
      "miss": "203.0.113.7 - - [24/Sep/2026:10:15:32 +0000] \"GET / HTTP/1.1\" 200 502 \"-\" \"test\""
    },
    "error": {
      "pattern": "?\"upstream timed out\" ?\"no live upstreams\" ?\"connect() failed\"",
      "match": "2026/09/24 10:15:32 [error] upstream timed out",
      "miss": "2026/09/24 10:15:32 [notice] signal process started"
    }
  },
  "log_segment": "",
  "reference_only": true
}
