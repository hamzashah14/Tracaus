# Customer-operated web UI. Copy to ignored .env or configure workload environment.
# Paste values from the reviewed routing stack's RuntimeConnection output.
# Default (local single-user) mode: at least 12 characters. Not used when TRACAUS_TEAM_FILE is set.
# scripts/run_customer_ui.py does not read this file; export APP_PASSWORD in its shell.
APP_PASSWORD=
ENVIRONMENT=development
RUNTIME_TARGET=standalone
# With MODEL_API, BEDROCK_REGION is the AWS region of the key secret and tool functions,
# and BEDROCK_MODEL_ID is the model name sent to the provider.
BEDROCK_REGION=
BEDROCK_MODEL_ID=
EXPECTED_ACCOUNT_ID=
ALLOWED_INSTANCE_IDS=
# Numeric, immutable Lambda versions in BEDROCK_REGION (standalone execution).
LOGS_TOOL_ARN=
METRICS_TOOL_ARN=
# Development only; see README ("Try it against your own CloudWatch"). Path to a one-file JSON
# tool config. The UI then runs the log and metric tools itself with your own AWS credentials.
# Needs ENVIRONMENT=development. Leave LOGS_TOOL_ARN, METRICS_TOOL_ARN and RUNTIME_RELEASE
# empty, and ALLOWED_INSTANCE_IDS empty or equal to the file's instances.
# TRACAUS_LOCAL_TOOLS=.local/local-tools.json
# Exact release fingerprint from RuntimeConnection; never invent a value.
RUNTIME_RELEASE=
RUNTIME_LIMITS={"tokens_reserved":32000,"model_steps":8,"tool_calls":8,"log_queries":24,"output_tokens":1024,"window_minutes":15,"context_bytes":48000,"tool_bytes":20000}
# For RUNTIME_TARGET=agentcore, select the reviewed immutable release endpoint.
AGENTCORE_RUNTIME_ARN=
AGENTCORE_ENDPOINT=
# Optional model provider instead of Amazon Bedrock. Unset means Bedrock. Standalone only:
# AgentCore is Bedrock only and rejects it. One-line JSON. Required keys: protocol
# ("openai" or "anthropic"), base_url (https DNS host), secret_arn (full ARN) and
# secret_version (pinned VersionId). Optional: bytes_per_token (1 to 8, openai only). The API
# key itself lives in AWS Secrets Manager, never here. Paste the value from RuntimeConnection
# and do not abbreviate it; see docs/DEPLOY.md.
# MODEL_API={"protocol":"openai","base_url":"https://api.example.com/v1", ... }
# Use the AWS credential chain: local SSO/profile, assumed role or workload role.
# AWS_PROFILE=default
# Optional incident status access; values from the durable foundation outputs.
MONITOR_REGION=
INCIDENT_TABLE=
REPORT_BUCKET=
# Team mode: path to team.toml. Sign-in settings go in .streamlit/secrets.toml.
# TRACAUS_TEAM_FILE=
# Native provider settings belong in ignored .streamlit/secrets.toml.

# TRACAUS_DIAGNOSTIC_POLICY is emitted by the reviewed RuntimeConnection. Copy its exact value;
# see docs/DEPLOY.md.
