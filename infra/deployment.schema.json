{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "environment",
    "account_id",
    "monitor_region",
    "bedrock_region",
    "release_id",
    "model_id",
    "executor_mode",
    "reserved_concurrency",
    "maintenance_mode",
    "log_retention_days",
    "ui_principal_arn",
    "ci_principal_arn",
    "deployment_role_arn",
    "instances",
    "log_segment",
    "reference_only"
  ],
  "properties": {
    "project": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}$"
    },
    "environment": {
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "account_id": {
      "type": "string",
      "pattern": "^[0-9]{12}$"
    },
    "monitor_region": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z]+-[0-9]$"
    },
    "bedrock_region": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z]+-[0-9]$"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,15}$"
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "model_provider": {
      "description": "bedrock invokes models through Amazon Bedrock; model_api calls a generic HTTPS model API with a Secrets Manager key (standalone runtime target only).",
      "enum": [
        "bedrock",
        "model_api"
      ],
      "default": "bedrock"
    },
    "model_api": {
      "description": "Required when model_provider is model_api; forbidden otherwise. The API key is never configured here; bind its pinned Secrets Manager version instead.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "base_url"
      ],
      "properties": {
        "protocol": {
          "enum": [
            "openai",
            "anthropic"
          ]
        },
        "base_url": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z]{2,63}(?:/[A-Za-z0-9._~/-]*)?(?!\\n)$"
        },
        "bytes_per_token": {
          "type": "number",
          "minimum": 1,
          "maximum": 8
        }
      },
      "if": {
        "properties": {
          "protocol": {
            "const": "anthropic"
          }
        },
        "required": [
          "protocol"
        ]
      },
      "then": {
        "properties": {
          "bytes_per_token": false
        }
      }
    },
    "model_arns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^arn:aws:bedrock:[a-z0-9-]+:(?:[0-9]{12})?:(?:foundation-model|inference-profile|application-inference-profile)/[A-Za-z0-9.:-]+$"
      }
    },
    "executor_mode": {
      "enum": [
        "qualified"
      ]
    },
    "notification_email": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._+%-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
    },
    "reserved_concurrency": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      ]
    },
    "maintenance_mode": {
      "type": "boolean"
    },
    "daily_token_budget": {
      "description": "Tokens all incident investigations together may reserve per UTC day. When it is used up, new investigations stop with a note and resume at 00:00 UTC. Default 2000000.",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "log_retention_days": {
      "enum": [
        7,
        14,
        30,
        60,
        90,
        180,
        365
      ]
    },
    "rollback_days": {
      "deprecated": true,
      "description": "Ignored; accepted only so existing configs still validate.",
      "type": "integer",
      "minimum": 7,
      "maximum": 90
    },
    "ui_principal_arn": {
      "type": "string",
      "pattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"
    },
    "ci_principal_arn": {
      "type": "string",
      "pattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"
    },
    "deployment_role_arn": {
      "type": "string",
      "pattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"
    },
    "ecs_services": {
      "description": "ECS services to investigate, next to or instead of EC2 instances. Tracaus only reads them.",
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cluster",
          "service",
          "load_balancer"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ecs-[a-z0-9_]{1,24}$"
          },
          "cluster": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,255}$"
          },
          "service": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,255}$"
          },
          "load_balancer": {
            "description": "null when no Application Load Balancer is in front of the service, otherwise the ALB and the target group the service uses.",
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "load_balancer_arn",
                  "target_group_arn"
                ],
                "properties": {
                  "load_balancer_arn": {
                    "type": "string",
                    "pattern": "^arn:aws:elasticloadbalancing:[a-z0-9-]+:[0-9]{12}:loadbalancer/app/[A-Za-z0-9-]{1,32}/[0-9a-f]{16}$"
                  },
                  "target_group_arn": {
                    "type": "string",
                    "pattern": "^arn:aws:elasticloadbalancing:[a-z0-9-]+:[0-9]{12}:targetgroup/[A-Za-z0-9-]{1,32}/[0-9a-f]{16}$"
                  }
                }
              }
            ]
          },
          "existing_log_groups": {
            "description": "Log groups the service writes to (awslogs). Tracaus reads them whole and never creates or changes them.",
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_./#-]{1,512}$"
                }
              }
            }
          },
          "resource_alarms": {
            "type": "boolean"
          },
          "container_insights": {
            "description": "True only if Container Insights is on for the cluster; adds a running-task-count alarm.",
            "type": "boolean"
          }
        }
      }
    },
    "instances": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "log_groups",
          "disk_path",
          "resource_alarms",
          "nginx_alarm",
          "process_exe"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^i-(?:[a-f0-9]{8}|[a-f0-9]{17})$"
          },
          "log_groups": {
            "type": "array",
            "minItems": 0,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,40}$"
            }
          },
          "existing_log_groups": {
            "description": "Log groups that already exist. Tracaus reads them and never creates or changes them.",
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_./#-]{1,512}$"
                },
                "streams": {
                  "enum": [
                    "instance",
                    "all"
                  ]
                }
              }
            }
          },
          "log_files": {
            "description": "Files the generated CloudWatch agent file ships, each to one of this instance's log groups.",
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "group",
                "file"
              ],
              "properties": {
                "group": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_./#-]{1,512}$"
                },
                "file": {
                  "type": "string",
                  "pattern": "^/[A-Za-z0-9_./*?-]{1,200}$"
                }
              }
            }
          },
          "disk_path": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9/_-]*$"
          },
          "resource_alarms": {
            "type": "boolean"
          },
          "nginx_alarm": {
            "type": "boolean"
          },
          "process_exe": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,40}$"
              }
            ]
          }
        }
      }
    },
    "nginx_filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access",
        "error"
      ],
      "properties": {
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern",
            "match",
            "miss"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "match": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "miss": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern",
            "match",
            "miss"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "match": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "miss": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        }
      }
    },
    "log_segment": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{0,24}$"
    },
    "reference_only": {
      "type": "boolean"
    },
    "observability": {
      "type": "object"
    },
    "notification_emails": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._+%-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "required": [
            "notification_email"
          ]
        },
        {
          "required": [
            "notification_emails"
          ]
        }
      ]
    },
    {
      "if": {
        "properties": {
          "model_provider": {
            "const": "model_api"
          }
        },
        "required": [
          "model_provider"
        ]
      },
      "then": {
        "required": [
          "model_api"
        ],
        "properties": {
          "model_arns": false,
          "model_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}(?!\\n)$"
          }
        }
      },
      "else": {
        "required": [
          "model_arns"
        ],
        "properties": {
          "model_api": false
        }
      }
    }
  ]
}
